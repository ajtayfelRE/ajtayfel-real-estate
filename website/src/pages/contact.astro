---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactLeadForm from "../components/contact/ContactLeadForm.astro";
import { site } from "../config/site";

const phoneHref = site.contact.phone.replace(/[^\d+]/g, "");
import "../styles/contact.css";
---

<BaseLayout
  title="Contact AJ Tayfel | REALTOR®"
  description="Contact AJ Tayfel for help buying, selling, or planning an out-of-state real estate move."
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Contact AJ</p>

      <h1>
        Let's talk about<br />
        what comes next.
      </h1>

      <p class="lede">
        Buying, selling, relocating, or still trying to understand your
        options? Start with a conversation.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <div class="contact-info">
        <p class="eyebrow">Direct Contact</p>

        <h2>
          Call, email,<br />
          or send a message.
        </h2>

        <p>
          Choose whichever method is easiest. The phone number and email below
          are directly clickable on desktop and mobile.
        </p>

        <div class="direct-actions">
          <a href={`tel:${phoneHref}`}>
            <span>Call AJ</span>
            <strong>{site.contact.phone}</strong>
            <b>↗</b>
          </a>

          <a href={`mailto:${site.contact.email}`}>
            <span>Email AJ</span>
            <strong>{site.contact.email}</strong>
            <b>↗</b>
          </a>
        </div>

        <div class="identity">
          <strong>{site.agent.fullName}, {site.agent.title}</strong>
          <span>{site.agent.brokerage}</span>
          <span>{site.address.city}, {site.address.state}</span>
        </div>
      </div>

      <div class="form-column">
        <p class="eyebrow">Send a Message</p>

        <h2>Tell me what you are planning.</h2>

        <p class="form-intro">
          A little context is enough to get the conversation started.
        </p>

        <ContactLeadForm />
      </div>
    </div>
  </section>
</BaseLayout>
