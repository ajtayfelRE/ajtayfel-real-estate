---
export interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const {
  eyebrow = "Relocation Services",
  title,
  description
} = Astro.props;
---

<section class="relocation-hero">

  <div class="container hero-inner">

    <p class="eyebrow">
      {eyebrow}
    </p>

    <h1>
      {title}
    </h1>

    <p class="hero-description">
      {description}
    </p>

    <div class="hero-actions">

      <a
        href="#destinations"
        class="button primary"
      >
        Explore Destinations
      </a>

      <a
        href="#how-it-works"
        class="button secondary"
      >
        How It Works
      </a>

    </div>

  </div>

</section>

<style>

.relocation-hero {
  padding: 7rem 0;
  background:
    linear-gradient(
      135deg,
      rgba(11, 60, 93, .96),
      rgba(20, 82, 120, .92)
    );
  color: white;
}

.hero-inner {
  max-width: 850px;
}

.eyebrow {
  margin-bottom: 1rem;
  font-size: .9rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent);
}

h1 {
  max-width: 800px;
  margin-bottom: 1.5rem;
  font-size: clamp(2.8rem, 6vw, 5rem);
  line-height: 1.05;
}

.hero-description {
  max-width: 720px;
  font-size: 1.2rem;
  color: rgba(255,255,255,.88);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2.25rem;
}

.button.secondary {
  background: transparent;
  color: white;
  border-color: rgba(255,255,255,.8);
}

@media (max-width: 700px) {

  .relocation-hero {
    padding: 5rem 0;
  }

}

</style>
