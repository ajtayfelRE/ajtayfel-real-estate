---
const apiUrl = import.meta.env.PUBLIC_RELOCATION_API_URL ?? "";
---

<section class="lead-section" aria-labelledby="relocation-form-heading">
  <div class="lead-shell">
    <div class="lead-intro">
      <p class="eyebrow">Relocation Planning</p>

      <h2 id="relocation-form-heading">
        Planning a move from Illinois to Southwest Florida?
      </h2>

      <p>
        Tell me a little about your move. I can help coordinate the Illinois
        side and connect you with an appropriate real estate professional in
        Southwest Florida when needed.
      </p>

      <p class="lead-note">
        No obligation. This is simply the starting point for understanding
        your timing, locations, and real estate needs.
      </p>
    </div>

    <form
      id="relocation-lead-form"
      class="lead-form"
      data-api-url={apiUrl}
    >
      <div class="form-grid">
        <div class="field">
          <label for="first_name">First name</label>
          <input
            id="first_name"
            name="first_name"
            type="text"
            autocomplete="given-name"
            required
          />
        </div>

        <div class="field">
          <label for="last_name">Last name</label>
          <input
            id="last_name"
            name="last_name"
            type="text"
            autocomplete="family-name"
            required
          />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>

        <div class="field">
          <label for="phone">Phone <span>(optional)</span></label>
          <input
            id="phone"
            name="phone"
            type="tel"
            autocomplete="tel"
          />
        </div>

        <div class="field">
          <label for="current_city">Current city</label>
          <input
            id="current_city"
            name="current_city"
            type="text"
            autocomplete="address-level2"
            placeholder="Chicago, Naperville, Wheaton..."
          />
        </div>

        <div class="field">
          <label for="current_state">Current state</label>
          <input
            id="current_state"
            name="current_state"
            type="text"
            value="IL"
            maxlength="2"
            autocomplete="address-level1"
            required
          />
        </div>

        <div class="field">
          <label for="destination_city">
            Southwest Florida destination
          </label>

          <select id="destination_city" name="destination_city">
            <option value="">Not sure yet</option>
            <option value="Fort Myers">Fort Myers</option>
            <option value="Cape Coral">Cape Coral</option>
            <option value="Naples">Naples</option>
            <option value="Bonita Springs">Bonita Springs</option>
            <option value="Estero">Estero</option>
            <option value="Marco Island">Marco Island</option>
            <option value="Other Southwest Florida">
              Other Southwest Florida
            </option>
          </select>
        </div>

        <div class="field">
          <label for="relocation_type">What do you expect to do?</label>

          <select
            id="relocation_type"
            name="relocation_type"
            required
          >
            <option value="">Select one</option>
            <option value="both">
              Sell in Illinois and buy in Florida
            </option>
            <option value="selling">
              Sell in Illinois
            </option>
            <option value="buying">
              Buy in Florida
            </option>
            <option value="researching">
              Still researching
            </option>
          </select>
        </div>

        <div class="field">
          <label for="timeframe">Expected timeframe</label>

          <select id="timeframe" name="timeframe" required>
            <option value="">Select one</option>
            <option value="0-3 months">0–3 months</option>
            <option value="3-6 months">3–6 months</option>
            <option value="6-12 months">6–12 months</option>
            <option value="12+ months">12+ months</option>
            <option value="not sure">Not sure yet</option>
          </select>
        </div>

        <div class="field">
          <label for="price_range">
            Approximate Florida purchase range
          </label>

          <select id="price_range" name="price_range">
            <option value="">Not sure / not applicable</option>
            <option value="under-300k">Under $300,000</option>
            <option value="300k-500k">$300,000–$500,000</option>
            <option value="500k-750k">$500,000–$750,000</option>
            <option value="750k-1m">$750,000–$1 million</option>
            <option value="1m+">$1 million+</option>
          </select>
        </div>

        <div class="field full">
          <label for="has_agent">
            Are you already working with a real estate agent?
          </label>

          <select id="has_agent" name="has_agent">
            <option value="">Select one</option>
            <option value="no">No</option>
            <option value="illinois">
              Yes, in Illinois only
            </option>
            <option value="florida">
              Yes, in Florida only
            </option>
            <option value="both">
              Yes, in both markets
            </option>
          </select>
        </div>

        <div class="field full">
          <label for="notes">
            Anything else I should know? <span>(optional)</span>
          </label>

          <textarea
            id="notes"
            name="notes"
            rows="5"
            maxlength="2000"
            placeholder="Neighborhoods, timing, home to sell, questions, or anything else about the move."
          ></textarea>
        </div>
      </div>

      <input
        type="hidden"
        name="destination_state"
        value="FL"
      />

      <input
        type="hidden"
        name="source"
        value="chicago-to-southwest-florida"
      />

      <div class="honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input
          id="website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <label class="consent">
        <input
          id="consent_contact"
          name="consent_contact"
          type="checkbox"
          required
        />

        <span>
          I agree that AJ Tayfel may contact me about this relocation request.
        </span>
      </label>

      <button id="submit-button" class="submit-button" type="submit">
        Start My Relocation Plan
      </button>

      <p
        id="form-status"
        class="form-status"
        role="status"
        aria-live="polite"
      ></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>(
    "#relocation-lead-form"
  );

  const status = document.querySelector<HTMLElement>("#form-status");

  const submitButton = document.querySelector<HTMLButtonElement>(
    "#submit-button"
  );

  if (form && status && submitButton) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const apiUrl = form.dataset.apiUrl;

      if (!apiUrl) {
        status.textContent =
          "The relocation form is temporarily unavailable. Please try again later.";
        status.dataset.state = "error";
        return;
      }

      if (!form.reportValidity()) {
        return;
      }

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      payload.consent_contact =
        formData.get("consent_contact") === "on";

      submitButton.disabled = true;
      submitButton.textContent = "Sending...";

      status.textContent = "";
      status.dataset.state = "";

      try {
        const response = await fetch(
          `${apiUrl}/leads/relocation`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
          }
        );

        let data = {};

        try {
          data = await response.json();
        } catch {
          // A non-JSON response will be handled below.
        }

        if (!response.ok) {
          throw new Error("Submission failed");
        }

        form.reset();

        status.textContent =
          "Thanks — your relocation request was received. I’ll review the details and follow up.";
        status.dataset.state = "success";
      } catch (error) {
        console.error(error);

        status.textContent =
          "Something went wrong while sending your request. Please try again.";
        status.dataset.state = "error";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Start My Relocation Plan";
      }
    });
  }
</script>

<style>
  .lead-section {
    padding: clamp(5rem, 10vw, 9rem) 1.25rem;
    background: #f2eee6;
  }

  .lead-shell {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }

  .lead-intro {
    position: sticky;
    top: 7rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #a88b55;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .lead-intro h2 {
    margin: 0 0 1.4rem;
    color: #102c3c;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -.03em;
  }

  .lead-intro p {
    color: #647078;
    line-height: 1.8;
  }

  .lead-note {
    margin-top: 1rem;
    font-size: .88rem;
  }

  .lead-form {
    padding: clamp(1.75rem, 4vw, 3rem);
    background: #fff;
    border: 1px solid rgba(16,44,60,.14);
    border-radius: 2px;
    box-shadow: 0 22px 60px rgba(9,36,50,.08);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.35rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .field.full {
    grid-column: 1 / -1;
  }

  .field label {
    color: #102c3c;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .045em;
  }

  .field label span {
    color: #7b858a;
    font-weight: 400;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 50px;
    padding: .85rem .9rem;
    border: 0;
    border-bottom: 1px solid rgba(16,44,60,.28);
    border-radius: 0;
    background: #fbfaf6;
    color: #222;
    font: inherit;
  }

  .field textarea {
    min-height: 130px;
    resize: vertical;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 1px solid #102c3c;
    outline-offset: 0;
    border-bottom-color: #102c3c;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: .75rem;
    margin: 1.7rem 0;
    color: #59666d;
    font-size: .85rem;
    line-height: 1.6;
  }

  .consent input {
    margin-top: .25rem;
    accent-color: #102c3c;
  }

  .submit-button {
    width: 100%;
    min-height: 54px;
    border: 1px solid #092432;
    border-radius: 2px;
    cursor: pointer;
    background: #092432;
    color: #fff;
    font: inherit;
    font-weight: 800;
    transition:
      transform .2s ease,
      background .2s ease;
  }

  .submit-button:hover,
  .submit-button:focus-visible {
    transform: translateY(-2px);
    background: #143b4d;
  }

  .submit-button:disabled {
    cursor: wait;
    opacity: .6;
    transform: none;
  }

  .form-status {
    min-height: 1.5rem;
    margin: 1rem 0 0;
    font-size: .9rem;
    font-weight: 700;
  }

  .form-status[data-state="success"] {
    color: #176b38;
  }

  .form-status[data-state="error"] {
    color: #9f1d1d;
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 850px) {
    .lead-shell,
    .form-grid {
      grid-template-columns: 1fr;
    }

    .lead-intro {
      position: static;
    }
  }
</style>
