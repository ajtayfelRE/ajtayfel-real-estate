---
export interface Props {
  title: string;
  description: string;
  href: string;
  label?: string;
}

const {
  title,
  description,
  href,
  label = "Explore relocation guide"
} = Astro.props;
---

<article class="destination-card">

  <div>

    <p class="card-kicker">
      Relocation Guide
    </p>

    <h3>
      {title}
    </h3>

    <p>
      {description}
    </p>

  </div>

  <a href={href}>
    {label} →
  </a>

</article>

<style>

.destination-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 2rem;
  min-height: 290px;
  padding: 2.25rem;
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.card-kicker {
  margin-bottom: .75rem;
  color: var(--secondary);
  font-size: .8rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
}

h3 {
  margin-bottom: 1rem;
  color: var(--primary);
  font-size: 1.65rem;
  line-height: 1.2;
}

p {
  color: var(--text-light);
}

a {
  color: var(--primary);
  font-weight: 700;
}

a:hover {
  color: var(--secondary);
}

</style>
