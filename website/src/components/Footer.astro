---
import { site } from "../config/site";

const phoneHref = site.contact.phone.replace(/[^\d+]/g, "");
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <img
        src="/branding/Full-Logo-Standard-White.png"
        alt="Real People Realty"
        class="footer-logo"
        width="190"
        height="52"
      />

      <div class="agent-details">
        <strong>{site.agent.fullName}</strong>
        <span>{site.agent.title}</span>
        <span>{site.agent.brokerage}</span>
      </div>
    </div>

    <div class="footer-contact">
      <p class="footer-label">Contact</p>

      <a href={`tel:${phoneHref}`}>
        {site.contact.phone}
      </a>

      <a href={`mailto:${site.contact.email}`}>
        {site.contact.email}
      </a>

      <span>
        {site.address.city}, {site.address.state}
      </span>
    </div>

    <div class="footer-compliance">
      <img
        src="/branding/Equal-Housing-white.png"
        alt="Equal Housing Opportunity"
        class="equal-housing"
        width="40"
        height="40"
      />

      <div>
        <p>Equal Housing Opportunity.</p>

        <p>
          Florida real estate services, when applicable, are provided by
          appropriately licensed Florida real estate professionals.
        </p>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>
      &copy; {new Date().getFullYear()} {site.agent.fullName}. All rights reserved.
    </p>

    <p>
      {site.agent.fullName}, {site.agent.title}
      <span aria-hidden="true"> · </span>
      {site.agent.brokerage}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --footer-bg: #102c3c;
    --footer-line: rgba(255,255,255,.15);
    --footer-muted: rgba(255,255,255,.67);
    --footer-gold: #a88b55;

    padding: 2.75rem 0 1.2rem;
    background: var(--footer-bg);
    color: rgba(255,255,255,.86);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr .75fr 1.15fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: block;
    width: 180px;
    max-width: 100%;
    height: auto;
  }

  .agent-details {
    display: flex;
    flex-direction: column;
    gap: .12rem;
  }

  .agent-details strong {
    color: white;
    font-size: .95rem;
  }

  .agent-details span {
    color: var(--footer-muted);
    font-size: .78rem;
    line-height: 1.5;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: .45rem;
  }

  .footer-label {
    margin: 0 0 .35rem;
    color: var(--footer-gold);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .footer-contact a {
    width: fit-content;
    color: white;
    font-size: .88rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .2em;
  }

  .footer-contact span {
    margin-top: .15rem;
    color: var(--footer-muted);
    font-size: .78rem;
  }

  .footer-compliance {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 1rem;
    align-items: start;
    color: var(--footer-muted);
    font-size: .74rem;
    line-height: 1.55;
  }

  .equal-housing {
    display: block;
    width: 34px;
    height: auto;
  }

  .footer-compliance p {
    margin: 0;
  }

  .footer-compliance p + p {
    margin-top: .55rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--footer-line);
    color: rgba(255,255,255,.5);
    font-size: .68rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 800px) {
    .site-footer {
      padding-top: 2.5rem;
    }

    .footer-main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-logo {
      width: 165px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: .4rem;
    }
  }
</style>
