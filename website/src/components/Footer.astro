---
import { site } from "../config/site";

const phoneHref = site.contact.phone.replace(/[^\d+]/g, "");
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img
        src="/branding/Full-Logo-Standard-White.png"
        alt="Real People Realty"
        class="footer-logo"
        width="260"
        height="70"
      />

      <div class="agent-details">
        <strong>{site.agent.fullName}</strong>
        <span>{site.agent.title}</span>
        <span>{site.agent.brokerage}</span>
      </div>
    </div>

    <div class="footer-contact">
      <h2>Contact</h2>

      <a href={`tel:${phoneHref}`}>
        {site.contact.phone}
      </a>

      <a href={`mailto:${site.contact.email}`}>
        {site.contact.email}
      </a>

      <span>
        {site.address.city}, {site.address.state}
      </span>
    </div>

    <div class="footer-compliance">
      <img
        src="/branding/Equal-Housing-white.png"
        alt="Equal Housing Opportunity"
        class="equal-housing"
        width="55"
        height="55"
      />

      <p>
        Equal Housing Opportunity.
      </p>

      <p>
        Florida real estate services, when applicable, are provided by
        appropriately licensed Florida real estate professionals.
      </p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>
      &copy; {new Date().getFullYear()} {site.agent.fullName}.
      All rights reserved.
    </p>

    <p>
      {site.agent.fullName}, {site.agent.title} &middot;
      {site.agent.brokerage}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 4rem 0 1.5rem;
    background: var(--primary);
    color: rgba(255, 255, 255, .88);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-logo {
    display: block;
    width: min(260px, 100%);
    height: auto;
  }

  .agent-details {
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }

  .agent-details strong {
    color: white;
    font-size: 1.2rem;
  }

  .agent-details span {
    font-size: .92rem;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: .55rem;
  }

  .footer-contact h2 {
    margin-bottom: .35rem;
    color: white;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .footer-contact a {
    color: white;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .footer-contact a:hover,
  .footer-contact a:focus-visible {
    text-decoration-thickness: 2px;
  }

  .footer-compliance {
    font-size: .82rem;
    line-height: 1.5;
  }

  .equal-housing {
    width: 46px;
    height: auto;
    margin-bottom: .75rem;
  }

  .footer-compliance p + p {
    margin-top: .75rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, .18);
    font-size: .78rem;
    color: rgba(255, 255, 255, .7);
  }

  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
    }
  }
</style>
