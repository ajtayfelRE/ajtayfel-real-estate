---
import { site } from "../config/site";
import { navigation } from "../config/navigation";
---

<header class="site-header">
  <div class="container header-content">
    <a href="/" class="brand" aria-label="AJ Tayfel home">
      <img
        src="/branding/Full-Logo-Standard-Dark.png"
        alt="Real People Realty"
        class="brokerage-logo"
        width="220"
        height="58"
      />

      <span class="agent-identity">
        <strong>{site.agent.fullName}</strong>
        <span>{site.agent.title}</span>
      </span>
    </a>

    <nav aria-label="Primary navigation">
      {
        navigation.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: white;
    box-shadow: var(--shadow);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: .85rem 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    min-width: max-content;
  }

  .brokerage-logo {
    display: block;
    width: 180px;
    height: auto;
  }

  .agent-identity {
    display: flex;
    flex-direction: column;
    padding-left: 1rem;
    border-left: 1px solid rgba(0, 0, 0, .14);
    line-height: 1.25;
  }

  .agent-identity strong {
    color: var(--primary);
    font-size: 1.05rem;
  }

  .agent-identity span {
    margin-top: .2rem;
    color: var(--text-light);
    font-size: .8rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1.35rem;
  }

  nav a {
    font-size: .92rem;
    font-weight: 600;
  }

  nav a:hover {
    color: var(--secondary);
  }

  @media (max-width: 950px) {
    .header-content {
      flex-direction: column;
      gap: .8rem;
    }

    nav {
      justify-content: center;
      gap: .75rem 1.15rem;
    }
  }

  @media (max-width: 560px) {
    .brand {
      width: 100%;
      justify-content: center;
      gap: .7rem;
    }

    .brokerage-logo {
      width: 145px;
    }

    .agent-identity {
      padding-left: .7rem;
    }

    .agent-identity strong {
      font-size: .9rem;
    }

    nav {
      font-size: .9rem;
    }
  }
</style>
