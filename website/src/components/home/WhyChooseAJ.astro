---
import SectionHeader from "../ui/SectionHeader.astro";
---

<section class="why-aj">

  <div class="container">

    <SectionHeader
      eyebrow="Why Choose AJ"
      title="A Local Approach You Can Trust"
      intro="Real estate is more than buying and selling property. It's about helping people make confident decisions with honest advice, local knowledge, and personalized service."
    />

    <div class="grid-3">

      <article class="card">

        <h3>📍 Local Market Expertise</h3>

        <p>
          Deep knowledge of DuPage County communities, neighborhood trends,
          and current market conditions.
        </p>

      </article>

      <article class="card">

        <h3>🤝 Personalized Guidance</h3>

        <p>
          Every client receives responsive communication, honest advice,
          and a strategy tailored to their goals.
        </p>

      </article>

      <article class="card">

        <h3>📈 Strategic Marketing</h3>

        <p>
          Professional marketing, modern technology, and skilled negotiation
          designed to help you achieve the best possible outcome.
        </p>

      </article>

    </div>

  </div>

</section>
